rules_version = '2';

// このアプリはFirestoreへ、Next.jsのRoute Handler・Firebase Cloud Functions
// (いずれもFirebase Admin SDK、サーバー側)からのみアクセスする。
// ブラウザ(クライアントSDK)から直接Firestoreを読み書きすることは無いため、
// クライアントSDK経由のアクセスはすべて拒否する
// (Admin SDKはこのルールの対象外であり、常にフルアクセスできる)。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "osaka-hinan-app-functions",
  "version": "0.1.0",
  "private": true,
  "description": "試作3 PART 1: Firebase Scheduled Functionsによる監視地点の定期確認（技術検証段階）",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "check:standalone": "node lib/runStandalone.js",
    "test": "node --test lib_test/*.test.js"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "typescript": "^5"
  }
}

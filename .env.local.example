# このファイルは変数名の一覧のみで、実際の値は含んでいません(Gitで管理してよい)。
# 実際の値は .env.local （Gitで管理しない）と、Vercelの Environment Variables に
# それぞれ設定してください。

# --- openrouteservice（試作1から。既存） ---
OPENROUTESERVICE_API_KEY=

# --- Firebase Web設定（公開されてよい値。Firebase Console > プロジェクトの設定 >
#     全般 > マイアプリ > SDKの設定と構成 から取得） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- FCM Web Push証明書（VAPIDキー）。公開鍵。Firebase Console >
#     プロジェクトの設定 > Cloud Messaging > ウェブ構成 > Web Push証明書 で
#     「鍵ペアを生成」して表示された文字列 ---
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin SDK（サーバー専用・絶対非公開）。Firebase Console >
#     プロジェクトの設定 > サービスアカウント > 「新しい秘密鍵の生成」で
#     ダウンロードされるJSONファイルの中身から転記する。
#     FIREBASE_ADMIN_PRIVATE_KEY は複数行のPEM形式なので、改行を "\n" という
#     2文字（バックスラッシュ+n）に置き換えてダブルクォートで囲むこと。
#     例: FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- 手動テスト通知の保護用（開発者が自分で決めた、ある程度長いランダム文字列でよい） ---
TEST_NOTIFICATION_SECRET=

# --- 開発者用テストUIの表示切り替え（"1"にすると画面左下にテスト通知パネルが出る。
#     一般公開時は未設定 または "1"以外にしておくこと） ---
NEXT_PUBLIC_ENABLE_DEV_TOOLS=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ただし値を含まない変数名一覧は例外としてコミットする
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 地域境界データのビルド用一時ダウンロード（国土数値情報N03、約29MB）。
# scripts/build-region-boundaries.mjs が実行のたびに再取得するため、
# 最終成果物(data/region-boundaries/*.geojson)のみをコミット対象とする。
data/raw/n03-source/
